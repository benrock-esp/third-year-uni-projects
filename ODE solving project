    numSteps = int(xMax / stepSize)

    # Initialize solvers
    euler = EulerSolver(defineOdeFunction, 0.0, 0.0, stepSize, numSteps)
    ab2 = AdamsBashforth2Solver(defineOdeFunction, 0.0, 0.0, stepSize, numSteps)
    rk4 = RungeKutta4Solver(defineOdeFunction, 0.0, 0.0, stepSize, numSteps)

    # Run solvers
    xEuler, yEuler = euler.solveOde()
    xAb2, yAb2 = ab2.solveOde()
