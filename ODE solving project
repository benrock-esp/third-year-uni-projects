import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Define ODE function and exact solution
def defineOdeFunction(x, y):
    return -8 * y + 6 * np.exp(-2 * x)

def computeExactSolution(x):
    return np.exp(-2 * x) - np.exp(-8 * x)

# Define base class for ODE solvers
class ODESolver:
    def __init__(self, odeFunction, x0, y0, stepSize, numSteps):
        self.odeFunction = odeFunction
        self.x0 = x0
        self.y0 = y0
        self.stepSize = stepSize
        self.numSteps = int(numSteps)
        self.xValues = np.zeros(numSteps + 1)

        # Handle scalar or vector initial conditions
        if np.ndim(y0) == 0:
            self.yValues = np.zeros(numSteps + 1)
        else:
            self.yValues = np.zeros((numSteps + 1, len(y0)))

        self.xValues[0] = self.x0
        self.yValues[0] = self.y0

    def solveOde(self):
        for n in range(self.numSteps):
            self.computeNextStep(n)
        return self.xValues, self.yValues

class EulerSolver(ODESolver):
    def computeNextStep(self, n):
        self.xValues[n + 1] = self.x0 + (n + 1) * self.stepSize
        self.yValues[n + 1] = self.yValues[n] + self.stepSize * self.odeFunction(self.xValues[n], self.yValues[n])

class AdamsBashforth2Solver(ODESolver):
    def computeNextStep(self, n):
        if n == 0:
            # Use Euler method for first step
            self.xValues[n + 1] = self.x0 + (n + 1) * self.stepSize
            self.yValues[n + 1] = self.yValues[n] + self.stepSize * self.odeFunction(self.xValues[n], self.yValues[n])
        else:
            self.xValues[n + 1] = self.x0 + (n + 1) * self.stepSize
            self.yValues[n + 1] = self.yValues[n] + self.stepSize * (
                1.5 * self.odeFunction(self.xValues[n], self.yValues[n])
                - 0.5 * self.odeFunction(self.xValues[n - 1], self.yValues[n - 1])
            )

class RungeKutta4Solver(ODESolver):
    def computeNextStep(self, n):
        x, y, h = self.xValues[n], self.yValues[n], self.stepSize
        k1 = self.odeFunction(x, y)
        k2 = self.odeFunction(x + 0.5 * h, y + 0.5 * h * k1)
        k3 = self.odeFunction(x + 0.5 * h, y + 0.5 * h * k2)
        k4 = self.odeFunction(x + h, y + h * k3)
        self.yValues[n + 1] = y + (h / 6.0) * (k1 + 2 * k2 + 2 * k3 + k4)
        self.xValues[n + 1] = self.x0 + (n + 1) * h

# Test the solvers against known function to check they have been written correctly
def testSolvers():
    xStart = 0
    yStart = 0
    stepSize = 0.1
    numSteps = 50

    # Initialize solvers
    eulerSolver = EulerSolver(defineOdeFunction, xStart, yStart, stepSize, numSteps)
    ab2Solver = AdamsBashforth2Solver(defineOdeFunction, xStart, yStart, stepSize, numSteps)
    rk4Solver = RungeKutta4Solver(defineOdeFunction, xStart, yStart, stepSize, numSteps)

    # Run solvers
    xEuler, yEuler = eulerSolver.solveOde()
    xAb2, yAb2 = ab2Solver.solveOde()
    xRk4, yRk4 = rk4Solver.solveOde()

    # Compute exact solution for plotting
    xExact = np.linspace(xStart, xStart + numSteps * stepSize, 500)
    yExactVals = computeExactSolution(xExact)

    # Plot results
    plt.plot(xEuler, yEuler, 'o-', label='Euler')
    plt.plot(xAb2, yAb2, 's-', label='Adams-Bashforth 2')
    plt.plot(xRk4, yRk4, '^-', label='Runge-Kutta 4')
    plt.plot(xExact, yExactVals, 'k', label='Exact')
    plt.xlabel('x')
    plt.ylabel('y')
    plt.title('Comparison of ODE Solvers')
    plt.legend()
    plt.grid(True)
    plt.show()

def computeStabilityData(stepSize):
    numSteps = int(3.0 / stepSize)
    solver = AdamsBashforth2Solver(defineOdeFunction, x0=0.0, y0=0.0, stepSize=stepSize, numSteps=numSteps)
    xValues, yValues = solver.solveOde()
    yExact = computeExactSolution(xValues)
    error = yValues - yExact

    # Create table of results
    df = pd.DataFrame({
        "x_n": xValues,
        "Y_n": yValues,
        "y_exact": yExact,
        "Error": error
    })
    return df

# Run the stability analysis
def analyzeStability():
    for h in [0.5, 0.375, 0.25, 0.125, 0.1, 0.05]:
        print(f"\n=== Results for h = {h} ===")
        df = computeStabilityData(h)
        print(df.to_string(index=False))

        xValues = df["x_n"].values
        err = np.abs(df["Error"].values)
        zeroCheck = err > 1e-12  # Handle log(0) errors

        # Estimate gamma for instability
        print(f"\nRunning gamma estimates for h={h}:")
        for i in range(len(xValues) - 2):
            tailMask = np.zeros_like(zeroCheck, dtype=bool)
            tailMask[i:] = True
            mask = zeroCheck & tailMask
            if mask.sum() > 2:
                coeffs = np.polyfit(xValues[mask], np.log(err[mask]), 1)
                gammaEst = coeffs[0]
                print(f"x >= {xValues[i]:.3f} -> gamma ≈ {gammaEst:.3f}")

# Plot numerical solutions
def plotNumericalSolutions():
