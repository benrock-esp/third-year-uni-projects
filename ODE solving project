    plt.title(f"Numerical solutions with h={stepSize}")
    plt.legend()
    plt.grid(True)
    plt.show()

# Analyze error convergence
def analyzeErrorConvergence():
    xTarget = 0.16
    kValues = np.arange(0, 16)
    errorsEuler = []
    errorsAb2 = []
    errorsRk4 = []
    hValues = []

    for k in kValues:
        n = 2**k
        h = 0.16 / n
        hValues.append(h)

        # Run solvers
        euler = EulerSolver(defineOdeFunction, 0.0, 0.0, h, n)
        ab2 = AdamsBashforth2Solver(defineOdeFunction, 0.0, 0.0, h, n)
        rk4 = RungeKutta4Solver(defineOdeFunction, 0.0, 0.0, h, n)

        xEuler, yEuler = euler.solveOde()
        xAb2, yAb2 = ab2.solveOde()
        xRk4, yRk4 = rk4.solveOde()

        # Calculate and append errors
        yExactVal = computeExactSolution(xTarget)
        errorsEuler.append(np.abs(yEuler[-1] - yExactVal))
        errorsAb2.append(np.abs(yAb2[-1] - yExactVal))
        errorsRk4.append(np.abs(yRk4[-1] - yExactVal))

    # Create table of errors
    dfErrors = pd.DataFrame({
        "h": hValues,
        "Error_Euler": errorsEuler,
        "Error_AB2": errorsAb2,
        "Error_RK4": errorsRk4
    })
    print(dfErrors.to_string(index=False))

    # Calculate the gradients
    logH = np.log(hValues)
    logErrorsEuler = np.log(errorsEuler)
    logErrorsAb2 = np.log(errorsAb2)
    logErrorsRk4 = np.log(errorsRk4)

    mask = (logH >= -8) & (logH <= -4)
    filteredLogH = logH[mask]
    filteredLogErrorsEuler = logErrorsEuler[mask]
    filteredLogErrorsAb2 = logErrorsAb2[mask]
    filteredLogErrorsRk4 = logErrorsRk4[mask]

    slopeEuler, _ = np.polyfit(filteredLogH, filteredLogErrorsEuler, 1)
    slopeAb2, _ = np.polyfit(filteredLogH, filteredLogErrorsAb2, 1)
    slopeRk4, _ = np.polyfit(filteredLogH, filteredLogErrorsRk4, 1)

    print("\nGradients in the range log(h) = [-8, -4]:")
    print(f"Euler method: {slopeEuler:.4f}")
    print(f"AB2 method: {slopeAb2:.4f}")
    print(f"RK4 method: {slopeRk4:.4f}")

    # Plot log-log error graph
    plt.plot(logH, logErrorsEuler, 'o-', label="Euler")
    plt.plot(logH, logErrorsAb2, 's-', label="AB2")
    plt.plot(logH, logErrorsRk4, '^-', label="RK4")
    plt.xlabel("log(h)")
    plt.ylabel("log(|E_n| at x = 0.16)")
    plt.title("Plot of log(Global error) vs log(h)")
    plt.legend()
    plt.show()

def computeAnalyticSolution():
    alpha = 2
    p = (0.25 + (np.pi / np.log(2))**2)**0.5

    # Define system of equations
    def equationSystem(x, Y):
        y, z = Y
        dyDx = z
        dzDx = -p**2 * (1 + x)**(-alpha) * y
        return np.array([dyDx, dzDx])

    # Set initial conditions
    Y0 = np.array([0.0, 1.0])
    x0 = 0
    h = 0.001
    nSteps = int(1 / h)

    solver = RungeKutta4Solver(equationSystem, x0, Y0, h, nSteps)
    xValues, YValues = solver.solveOde()

    yVals = YValues[:, 0]
    zVals = YValues[:, 1]

    print(f"y(1) ≈ {yVals[-1]:.6e}, z(1) ≈ {zVals[-1]:.6e}")

def analyzeNumericalErrors():
    alpha = 2

    # Define system of equations
    def equationSystem(x, Y, p):
        y, z = Y
        dyDx = z
        dzDx = -p**2 * (1 + x)**(-alpha) * y
        return np.array([dyDx, dzDx])

    # Run RK4 solver for given p and h
    def runRk4(p, h):
        Y0 = np.array([0.0, 1.0])
        x0 = 0.0
        nSteps = int(1 / h)
        solver = RungeKutta4Solver(lambda x, Y: equationSystem(x, Y, p), x0, Y0, h, nSteps)
        xVals, YVals = solver.solveOde()
        yVals = YVals[:, 0]
        zVals = YVals[:, 1]
        return yVals[-1], zVals[-1]

    kValues = np.arange(0, 13)
    hValues = 0.1 / (2**kValues)

    # Compute results for p=4
    resultsP4 = []
    for h in hValues:
        w = (4**2 - 0.25)**0.5
        yeOne = 1 / w * (2**0.5) * np.sin(w * np.log(2))
        y1, z1 = runRk4(4, h)
        err = y1 - yeOne
        resultsP4.append([h, y1, z1, err])

    # Compute results for p=5
    resultsP5 = []
    for h in hValues:
        w = (5**2 - 0.25)**0.5
        yeOne = 1 / w * (2**0.5) * np.sin(w * np.log(2))
        y1, z1 = runRk4(5, h)
        err = y1 - yeOne
        resultsP5.append([h, y1, z1, err])

    # Create tables
    dfP4 = pd.DataFrame(resultsP4, columns=["h", "y(1)", "z(1)", "Error"])
    dfP5 = pd.DataFrame(resultsP5, columns=["h", "y(1)", "z(1)", "Error"])

    print("\n=== Results for p=4 ===")
    print(dfP4.to_string(index=False))

    print("\n=== Results for p=5 ===")
    print(dfP5.to_string(index=False))

    # Plot errors
    plt.plot(np.log(dfP4["h"]), np.log(np.abs(dfP4["Error"])), 'o-', label="p=4")
    plt.plot(np.log(dfP5["h"]), np.log(np.abs(dfP5["Error"])), 's-', label="p=5")
    plt.xlabel("log(h)")
    plt.ylabel("log(|Error at x=1|)")
    plt.title("Global error at x=1 vs step size h (log-log)")
    plt.grid(True)
    plt.legend()
    plt.show()

def computePhi(p, alpha, h, xTarget=1.0, x0=0.0, Y0=np.array([0.0, 1.0])):
    def equationSystem(x, Y):
        y, z = Y
        dyDx = z
        dzDx = -p**2 * (1 + x)**(-alpha) * y
        return np.array([dyDx, dzDx])

    nSteps = int(xTarget / h)
    solver = RungeKutta4Solver(equationSystem, x0, Y0, h, nSteps)
    xVals, YVals = solver.solveOde()
    return YVals[-1, 0]  # y at xTarget

def findEigenvalueWithFalsePosition(p1, p2, alpha, h, tolerance=5e-6):
    iterates = []
    f1 = computePhi(p1, alpha, h)
    f2 = computePhi(p2, alpha, h)

    while abs(p2 - p1) > tolerance:
        ps = (f2 * p1 - f1 * p2) / (f2 - f1)
        fPs = computePhi(ps, alpha, h)
        iterates.append((ps, fPs))
        if f1 * fPs < 0:
            p2, f2 = ps, fPs
        else:
            p1, f1 = ps, fPs

    pRoot = (p1 + p2) / 2
    return pRoot, iterates

def findSmallestEigenvalue():
    alpha = 2
    h = 0.001
    p1Init = 4.0
    p2Init = 5.0
    tolerance = 5e-6

    pRoot, iterates = findEigenvalueWithFalsePosition(p1Init, p2Init, alpha, h, tolerance)

    # Print iteration table
    print("Iteration | p | phi(p)")
    for i, (pIter, phiVal) in enumerate(iterates, 1):
        print(f"{i:9d} | {pIter:.8f} | {phiVal:.3e}")

    print(f"\nApproximate smallest eigenvalue p(1) ≈ {pRoot:.8f}")

def estimateStepSize():
    h = 0.001
    alpha = 2
    pValues = np.linspace(0, 100, 500)
    errorUpperBound = []

    for p in pValues:
        yN = computePhi(p, h=h, alpha=alpha)
        y2n = computePhi(p, h=h/2, alpha=alpha)
        upperBound = (15/14) * abs(yN - y2n)
        errorUpperBound.append(upperBound)

    # Plot error bounds
    plt.plot(pValues, errorUpperBound)
    plt.xlabel("p")
    plt.ylabel(r"$\frac{15}{14} |Y_n - Y_{2n}|$")
    plt.title("RK4 Global Error Upper Bound vs p")
    plt.grid(True)
    plt.show()

# Plot phi for eigenvalue estimation
def plotPhiValues():
    pValues = np.linspace(0, 100, 500)
    phiValues = np.array([computePhi(p, h=0.001, alpha=10) for p in pValues])
    plt.plot(pValues, phiValues)
    plt.xlabel("p")
    plt.ylabel("phi(p)")
    plt.grid(True)
    plt.show()

def computeMultipleEigenvalues():
    alpha = 10
    h = 0.001
    xTarget = 1.0
    x0 = 0.0
    Y0 = np.array([0.0, 1.0])
    tolerance = 5e-6

    eigenvalues = []
    eigenfunctions = []

    brackets = [(12, 14), (26, 28), (39, 41), (52, 54), (65, 67)]

    for k, (p1, p2) in enumerate(brackets, 1):
        pRoot, iterates = findEigenvalueWithFalsePosition(p1, p2, alpha, h, tolerance)
        eigenvalues.append(pRoot)

        # Compute eigenfunction
        nSteps = int(xTarget / h)
        solver = RungeKutta4Solver(lambda x, Y: np.array([Y[1], -pRoot**2 * (1 + x)**(-alpha) * Y[0]]), x0, Y0, h, nSteps)
        xVals, YVals = solver.solveOde()
        yVals = YVals[:, 0]

        # Apply energy normalization
        weight = (1 + xVals) ** (-alpha)
        normFactor = np.sqrt(np.trapz(weight * yVals**2, xVals))
        yValsNormalized = yVals / normFactor
        eigenfunctions.append((xVals, yValsNormalized))

        # Print iteration table
        print(f"\nEigenvalue {k} iterations:")
        print("Iteration | p | phi(p)")
        for i, (pIter, phiVal) in enumerate(iterates, 1):
            print(f"{i:9d} | {pIter:.8f} | {phiVal:.3e}")
        print(f"Approximated eigenvalue p({k}) ≈ {pRoot:.8f}")

    # Plot normalized eigenfunctions
    plt.figure(figsize=(10, 6))
    for k, (xVals, yVals) in enumerate(eigenfunctions, 1):
        plt.plot(xVals, yVals, label=f"y{k}, p≈{eigenvalues[k-1]:.4f}")
    plt.xlabel("x")
    plt.ylabel("y")
    plt.legend()
    plt.grid(True)
    plt.show()

    return eigenvalues, eigenfunctions
